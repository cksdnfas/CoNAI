{
  "name": "conai-backend",
  "version": "26.8.9",
  "description": "Backend API server for CoNAI",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --ignore 'database/**' --ignore 'uploads/**' --ignore '**/*.db' --signal SIGTERM --exec tsx src/index.ts",
    "build": "tsc && npm run copy:migrations",
    "typecheck": "tsc --noEmit",
    "copy:migrations": "copyfiles -u 1 \"src/database/migrations/**/*.sql\" dist/",
    "start": "node dist/backend/src/index.js",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@conai/shared": "file:../shared",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node-cron": "^3.0.11",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.2",
    "better-sqlite3-session-store": "^0.1.0",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "form-data": "^4.0.6",
    "helmet": "^8.1.0",
    "lru-cache": "^11.2.7",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "p-limit": "^7.3.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.3",
    "sharp-phash": "^2.2.0",
    "uuid": "^13.0.2",
    "ws": "^8.21.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^8.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express-session": "^1.18.2",
    "@types/form-data": "^2.2.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.37",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  }
}
