{
  "apiVersion": 1, "id": "moss-bbox-studio", "name": "MOSS BBox Studio", "version": "1.0.0",
  "description": "MOSS-Image 레이아웃 프롬프트를 영역 박스로 만들고 고쳐서, 등록한 ComfyUI 워크플로우로 생성 요청해.",
  "pages": [{
    "id": "studio", "title": "MOSS BBox Studio", "entry": "index.html", "icon": "layout-dashboard", "accepts": [], "opensImages": true,
    "actions": [
      { "id": "moss-bbox-studio.select_region", "label": "영역 고르기", "description": "번호로 영역 하나를 선택한다. 번호는 1부터이며 화면 목록의 번호와 같다.", "effect": "draft", "tier": "view", "schema": { "type": "object", "properties": { "number": { "type": "number", "integer": true, "minimum": 1, "maximum": 200 } }, "required": ["number"] } },
      { "id": "moss-bbox-studio.set_summary", "label": "메인 프롬프트 쓰기", "description": "장면 전체의 분위기와 스타일을 설명하는 메인 프롬프트(summary.caption)를 바꾼다. 영역에 들어갈 내용은 넣지 않는다.", "effect": "draft", "tier": "draft", "schema": { "type": "object", "properties": { "caption": { "type": "string", "maxLength": 4000 } }, "required": ["caption"] } },
      { "id": "moss-bbox-studio.set_region", "label": "영역 추가·수정", "description": "number가 있으면 그 영역을 고치고 없으면 새 영역을 추가한다. 박스는 캔버스 비율(0~1)의 왼쪽 위(x0,y0)와 오른쪽 아래(x1,y1)이며 네 값을 함께 준다. kind는 character(인물)·object(오브젝트)·text(그릴 글자, text에 글자 그대로). caption에는 그 영역 안에 있어야 할 것만 쓴다.", "effect": "draft", "tier": "draft", "schema": { "type": "object", "properties": { "number": { "type": "number", "integer": true, "minimum": 1, "maximum": 200 }, "kind": { "type": "string", "enum": ["character", "object", "text"] }, "caption": { "type": "string", "maxLength": 2000 }, "text": { "type": "string", "maxLength": 500 }, "x0": { "type": "number", "minimum": 0, "maximum": 1 }, "y0": { "type": "number", "minimum": 0, "maximum": 1 }, "x1": { "type": "number", "minimum": 0, "maximum": 1 }, "y1": { "type": "number", "minimum": 0, "maximum": 1 } } } },
      { "id": "moss-bbox-studio.remove_region", "label": "영역 삭제", "description": "번호로 영역 하나를 지운다.", "effect": "draft", "tier": "draft", "schema": { "type": "object", "properties": { "number": { "type": "number", "integer": true, "minimum": 1, "maximum": 200 } }, "required": ["number"] } },
      { "id": "moss-bbox-studio.set_size", "label": "캔버스 크기", "description": "캔버스 크기를 바꾼다. 16의 배수여야 하고 박스는 비율로 유지된다. 생성 크기와 같으니 워크플로우의 너비·높이 칸이 연결돼 있어야 한다.", "effect": "draft", "tier": "draft", "schema": { "type": "object", "properties": { "width": { "type": "number", "integer": true, "minimum": 256, "maximum": 4096 }, "height": { "type": "number", "integer": true, "minimum": 256, "maximum": 4096 } }, "required": ["width", "height"] } },
      { "id": "moss-bbox-studio.import_image", "label": "라이브러리 이미지 가져오기", "description": "라이브러리 이미지의 프롬프트(레이아웃 JSON)에서 영역을 읽어 와 편집 초안으로 연다. 지금 초안은 이 화면에서 되돌릴 수 있다.", "effect": "draft", "tier": "draft", "schema": { "type": "object", "properties": { "compositeHash": { "type": "string", "maxLength": 32 } }, "required": ["compositeHash"] } },
      { "id": "moss-bbox-studio.generate", "label": "생성 요청", "description": "지금 레이아웃으로 연결 설정에서 고른 ComfyUI 워크플로우에 생성 요청을 넣는다. 검토 카드에서 사람이 적용해야 실행된다. seed를 비우면 새 시드를 쓴다.", "effect": "save", "tier": "commit", "schema": { "type": "object", "properties": { "seed": { "type": "number", "integer": true, "minimum": 0, "maximum": 4294967295 } } } }
    ]
  }]
}
