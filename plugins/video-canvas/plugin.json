{
  "apiVersion": 1,
  "id": "video-canvas",
  "name": "영상 캔버스",
  "version": "1.0.4",
  "description": "앱의 이미지·영상·오디오·RefMod를 컷 입력 슬롯에 잇고, 등록한 DaSiWa Director 워크플로로 생성·검수·프레임 추출해.",
  "server": { "entry": "server.mjs" },
  "pages": [{
    "id": "canvas", "title": "영상 캔버스", "entry": "index.html", "icon": "layout-dashboard", "accepts": [], "opensImages": true,
    "actions": [
      { "id": "video-canvas.read", "label": "캔버스·작업 결과 읽기", "description": "결과는 반환값이 아니라 snapshot.data의 canvas/lastRead/lastNode/lastEdit/lastRun/lastCheck/lastExtraction/pendingExtractions에 게시해. section+cursor는 결과의 JSON 다음 조각, section 없이 cursor/edge_cursor는 캔버스 다음 페이지야. nextCursor를 끝까지 따라가.", "effect": "draft", "tier": "view", "schema": { "type": "object", "properties": { "section": { "type": "string" }, "cursor": { "type": "string" }, "edge_cursor": { "type": "string" }, "limit": { "type": "number", "integer": true, "minimum": 1 } } } },
      { "id": "video-canvas.read_node", "label": "노드 읽기", "description": "선택/조회 노드, 입력 digest, 연결선과 take 페이지를 lastNode에 게시해. nextEdgeCursor/nextTakeCursor를 해당 커서로 넘겨. 큰 텍스트는 read(section:lastNode,cursor)로 이어 읽어.", "effect": "draft", "tier": "view", "schema": { "type": "object", "properties": { "id": { "type": "string" }, "edge_cursor": { "type": "string" }, "take_cursor": { "type": "string" }, "limit": { "type": "number", "integer": true, "minimum": 1 } }, "required": ["id"] } },
      { "id": "video-canvas.select", "label": "선택", "description": "프로젝트 또는 노드를 선택해. 프로젝트 ID·이름·노드 수는 snapshot.data.projects에 있어. 큰 목록은 read의 section:projects와 nextCursor로 이어 읽어.", "effect": "draft", "tier": "draft", "schema": { "type": "object", "properties": { "project_id": { "type": "string" }, "id": { "type": "string" } } } },
      { "id": "video-canvas.edit", "label": "캔버스 편집", "description": "ops JSON 배열 문자열로 편집해. add_node/import_image/import_video/import_audio/import_bundle/import_launch, connect, disconnect, reorder, set, move, review를 지원해. tempId는 배치 안에서 쓸 수 있어. 삭제는 remove 작업으로 제안해. create_name은 프로젝트 생성, profile_json은 검증할 프로필 JSON, undo는 마지막 어시스턴트 배치 되돌리기야. 검수는 사람만 해.", "effect": "save", "tier": "direct", "schema": { "type": "object", "properties": { "expected_revision": { "type": "number", "integer": true, "minimum": 0 }, "ops": { "type": "string", "maxLength": 200000 }, "create_name": { "type": "string", "maxLength": 200000 }, "profile_json": { "type": "string", "maxLength": 200000 }, "undo": { "type": "boolean" } }, "required": ["expected_revision"] } },
      { "id": "video-canvas.check", "label": "소재·입력 체크", "description": "전체 또는 한 컷의 소재 존재·권한·변경·슬롯·한도·@이름을 검사해. 변경과 미사용 참조는 경고야.", "effect": "save", "tier": "direct", "schema": { "type": "object", "properties": { "expected_revision": { "type": "number", "integer": true, "minimum": 0 }, "cut_id": { "type": "string" } }, "required": ["expected_revision"] } },
      { "id": "video-canvas.run_cut", "label": "컷 지금 생성", "description": "현재 컷으로 즉시 생성해. take_id와 inputs take|canvas로 원래 입력·현재 입력을 구분하고 profile_id로 프로필을 바꿔. 시드는 항상 명시해. action retry는 같은 멱등 키로 재시도, cancel은 취소야.", "effect": "save", "tier": "direct", "schema": { "type": "object", "properties": { "expected_revision": { "type": "number", "integer": true, "minimum": 0 }, "cut_id": { "type": "string" }, "profile_id": { "type": "string" }, "take_id": { "type": "string" }, "inputs": { "type": "string", "enum": ["take", "canvas"] }, "new_seed": { "type": "boolean" }, "action": { "type": "string", "enum": ["retry", "cancel"] } }, "required": ["expected_revision"] } },
      { "id": "video-canvas.propose_run_cut", "label": "컷 생성 제안", "description": "lastNode.data.preview.review를 그대로 인자로 넣어. 카드에 모드·길이·시드·프로필 이름·전송 프롬프트·사운드·음악·슬롯/라벨 표가 표시돼. 서버가 카드의 모든 값과 입력 digest를 현재 컷에 대조한 뒤 생성해. 값이 달라지면 다시 읽고 제안해줘.", "effect": "save", "tier": "commit", "schema": { "type": "object", "properties": { "cut_id": { "type": "string" }, "input_digest": { "type": "string" }, "cut_mode": { "type": "string", "enum": ["T2VA", "I2VA", "FL2VA", "L2VA", "REF2VA"] }, "duration": { "type": "number", "integer": true }, "seed": { "type": "number", "integer": true }, "profile_id": { "type": "string" }, "profile_label": { "type": "string", "maxLength": 200000 }, "prompt": { "type": "string", "maxLength": 200000 }, "soundscape": { "type": "string", "maxLength": 200000 }, "music": { "type": "string", "maxLength": 200000 }, "slot_summary": { "type": "string", "maxLength": 200000 } }, "required": ["cut_id", "input_digest", "cut_mode", "duration", "seed", "profile_id", "profile_label", "prompt", "soundscape", "music", "slot_summary"] } },
      { "id": "video-canvas.extract_frame", "label": "영상 프레임 추출", "description": "라이브러리 영상 또는 준비된 take에서 프레임을 뽑아. job이 있으면 extraction_id로 조회·취소해. target으로 다른 컷의 시작·끝·참조 이미지 슬롯에 바로 연결해.", "effect": "save", "tier": "direct", "schema": { "type": "object", "properties": { "expected_revision": { "type": "number", "integer": true, "minimum": 0 }, "node_id": { "type": "string" }, "take_id": { "type": "string" }, "extraction_id": { "type": "string" }, "position": { "type": "string", "enum": ["first", "middle", "last"] }, "at_seconds": { "type": "array", "items": { "type": "number", "minimum": 0 } }, "frame_index": { "type": "number", "integer": true, "minimum": 0 }, "format": { "type": "string", "enum": ["png", "webp"] }, "cancel": { "type": "boolean" }, "target": { "type": "object", "properties": { "cut": { "type": "string" }, "port": { "type": "string", "enum": ["start", "end", "ref_image"] }, "position": { "type": "number", "integer": true, "minimum": 0 } }, "required": ["cut", "port"] } }, "required": ["expected_revision"] } },
      { "id": "video-canvas.remove", "label": "노드 삭제 제안", "description": "노드와 이 노드의 연결선을 지워. 생성 take는 이력으로 남아. 승인 전에 대상 ID를 확인해.", "effect": "save", "tier": "commit", "schema": { "type": "object", "properties": { "id": { "type": "string" }, "expected_revision": { "type": "number", "integer": true, "minimum": 0 } }, "required": ["id", "expected_revision"] } }
    ]
  }]
}
