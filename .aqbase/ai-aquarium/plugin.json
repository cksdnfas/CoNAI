          }
        },
        {
          "id": "ai-aquarium.rpg_prepare",
          "label": "길드 운영 초안",
          "description": "자율 탐험 활성화, GM과 GM 하루 한도, 층 수, 사망 손실, 물리 진행 속도, 게임 그림, 주민 역할과 참고 근무 습관(shifts)을 준비한다. 근무·수면·보급·장비·귀환 여부는 주민 모델이 결정한다. 모델 방식과 모든 주민 호출 한도는 prepare.deciders에서만 설정한다. 전투 off/boss 및 자동 규칙 대체는 없다. 저장은 사람이 적용한다.",
          "effect": "draft",
          "tier": "draft",
          "schema": {
            "type": "object",
            "properties": {
              "settings": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "gameArt": {
                    "type": "object",
                    "properties": {
