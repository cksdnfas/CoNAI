{
  "name": "frontend",
  "private": true,
  "version": "26.10.10",
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../shared",
    "dev": "vite",
    "prebuild": "npm run build --prefix ../shared",
    "build": "node scripts/build-production.mjs",
    "build:compiler-off": "node scripts/build-production.mjs --compiler=off",
    "build:compiler-on": "node scripts/build-production.mjs --compiler=on",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:posts-editor": "tsx --test test/post-rich-editor.test.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
