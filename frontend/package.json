    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@conai/shared": "file:../shared",
    "@lezer/highlight": "1.2.5",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@tanstack/react-query": "^5.91.3",
    "@virtuoso.dev/masonry": "^1.4.2",
    "@viselect/vanilla": "^3.9.0",
